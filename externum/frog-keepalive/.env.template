# Obtain this fingerprint from the owner's already trusted SSH client.
# Do not accept an unverified fingerprint from ssh-keyscan.
FROG_HOST_KEY_SHA256=SHA256:REPLACE_WITH_TRUSTED_FINGERPRINT

FROG_HOST=frog01.mikr.us
FROG_PORT=11157
FROG_USER=frog

# A successful login becomes due after this many days.
KEEPALIVE_INTERVAL_DAYS=60

# Subsequent due attempts receive zero to six hours of jitter.
MAX_JITTER_SECONDS=21600

RETRY_SECONDS=3600
CHECK_SECONDS=3600
CONNECT_TIMEOUT_SECONDS=20
